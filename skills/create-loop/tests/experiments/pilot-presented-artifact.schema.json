{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-presented-artifact-v1.json",
  "title": "create-loop pilot anonymous presented deliverable set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "algorithm", "pair_id", "case_id",
    "final_workspace_manifest_sha256", "files", "aggregate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sha256-pilot-presented-artifact-v1"},
    "pair_id": {"type": "string", "pattern": "^PL-(?:T2|T3|T5|T7)-P01$"},
    "case_id": {"enum": ["T2", "T3", "T5", "T7"]},
    "final_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "media_type", "purpose"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
