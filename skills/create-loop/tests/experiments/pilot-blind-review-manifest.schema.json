{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-blind-review-manifest-v1.json",
  "title": "create-loop pilot anonymous pairwise review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "review_id", "pair_id", "case_id", "reviewer",
    "producer_protocols_withheld", "reviewer_grant_sha256", "presented",
    "delivered_context", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "review_id": {"$ref": "#/$defs/id"},
    "pair_id": {"$ref": "#/$defs/reviewPairId"},
    "case_id": {"enum": ["T2", "T3", "T5", "T7"]},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "producer_protocols_withheld": {"const": true},
    "reviewer_grant_sha256": {"$ref": "#/$defs/sha256"},
    "presented": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/presented"}},
    "delivered_context": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/context"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "reviewPairId": {"type": "string", "pattern": "^PL-(?:T2|T3|T5|T7)-P01$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "model", "reasoning_effort", "context_isolation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "model"]},
        "model": {"$ref": "#/$defs/id"},
        "reasoning_effort": {"const": "ultra"},
        "context_isolation": {"const": "fresh-session"}
      }
    },
    "presented": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "artifact", "deliverable_root", "final_workspace_manifest_sha256", "evidence_manifest_sha256"],
      "properties": {
        "label": {"enum": ["A", "B"]},
        "artifact": {"$ref": "#/$defs/file"},
        "deliverable_root": {"$ref": "#/$defs/path"},
        "final_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
