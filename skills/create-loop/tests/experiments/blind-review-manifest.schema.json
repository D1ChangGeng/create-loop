{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-blind-review-manifest-v1.json",
  "title": "create-loop pairwise blind review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "preregistration_sha256", "review_id", "pair_id",
    "scenario_id", "reviewer", "producer_protocols_withheld", "assignment_seed", "presented",
    "delivered_context", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "review_id": {"$ref": "#/$defs/id"},
    "pair_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-4])-P0[1-3]$"},
    "scenario_id": {"type": "integer", "minimum": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
        "required": ["id", "kind", "model", "reasoning_effort", "context_isolation"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["human", "model"]},
          "model": {"$ref": "#/$defs/id"},
          "reasoning_effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra"]},
          "context_isolation": {"const": "fresh-session"}
      }
    },
    "producer_protocols_withheld": {"const": true},
    "assignment_seed": {"type": "integer", "minimum": 0},
    "presented": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "presented_artifact", "trace_sha256"],
        "properties": {
          "label": {"enum": ["A", "B"]},
          "presented_artifact": {"$ref": "#/$defs/fileBinding"},
          "trace_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "delivered_context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "purpose"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
