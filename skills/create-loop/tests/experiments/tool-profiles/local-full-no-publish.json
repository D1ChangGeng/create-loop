{
  "schema_version": "1.0",
  "id": "local-full-no-publish",
  "network": "denied",
  "publish": "denied",
  "external_effects": "simulated-workspace-only",
  "writable_roots": ["workspace"],
  "allowed_capabilities": [
    "execute-local",
    "read-workspace",
    "write-declared-workspace-paths"
  ],
  "denied_capabilities": [
    "credentials",
    "delete-outside-workspace",
    "network",
    "payment",
    "publish"
  ],
  "environment": {
    "allow": ["PATH", "PYTHONIOENCODING", "PYTHONDONTWRITEBYTECODE"],
    "deny_prefixes": ["ANTHROPIC_", "AWS_", "GITHUB_TOKEN", "OPENAI_"],
    "credential_allow": []
  }
}
