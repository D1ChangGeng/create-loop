{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-workspace-manifest-v1.json",
  "title": "create-loop experiment materialized workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "algorithm", "experiment_id", "pair_id", "scenario_id",
    "scenario_slug", "protocol", "workspace_seed", "input_sha256", "fixture_id",
    "fixture_sha256", "semantic_case_sha256", "variant_sha256", "protocol_source", "builder_sha256",
    "tool_profile", "root", "files", "aggregate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sha256-workspace-manifest-v1"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "pair_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-4])-P0[1-3]$"},
    "scenario_id": {"type": "integer", "minimum": 1},
    "scenario_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "protocol": {"enum": ["v1", "v2"]},
    "workspace_seed": {"type": "integer", "minimum": 0},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_id": {"type": "string", "pattern": "^builtin:[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_case_sha256": {"$ref": "#/$defs/sha256"},
    "variant_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_source": {"$ref": "#/$defs/protocolSource"},
    "builder_sha256": {"$ref": "#/$defs/sha256"},
    "tool_profile": {"$ref": "#/$defs/fileBindingWithId"},
    "root": {"const": "."},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "fileBindingWithId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocolSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "aggregate_sha256", "manifest"],
      "properties": {
        "protocol": {"enum": ["v1", "v2"]},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["0644", "0755"]}
      }
    }
  }
}
