{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-trace-source-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "episode_id", "attempt_id", "started_at", "ended_at", "events", "completion_claim", "not_measured_metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "#/$defs/id"}, "episode_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "started_at": {"$ref": "#/$defs/timestamp"}, "ended_at": {"$ref": "#/$defs/timestamp"},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "completion_claim": {"type": "object"},
    "not_measured_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
