{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-authorization-grant-v2.json",
  "title": "create-loop immutable experiment execution grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authorization_id", "execution_id", "execution_root_sha256",
    "experiment_id", "preregistration_sha256", "run_plan_sha256", "role",
    "adapter", "cli_identity", "provider_profile", "model", "reasoning_effort",
    "tool_profile", "authorized_calls", "limits", "authorized_by", "authorized_at",
    "expires_at", "authority_evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "execution_id": {"$ref": "#/$defs/id"},
    "execution_root_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "run_plan_sha256": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["producer", "reviewer", "calibration"]},
    "adapter": {"$ref": "#/$defs/adapter"},
    "cli_identity": {"$ref": "#/$defs/fileBindingWithId"},
    "provider_profile": {"$ref": "#/$defs/fileBindingWithId"},
    "model": {"$ref": "#/$defs/id"},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    "tool_profile": {"$ref": "#/$defs/fileBindingWithId"},
    "authorized_calls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/call"}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "authority_evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "calibration"}}, "required": ["role"]},
      "then": {
        "properties": {
          "authorized_calls": {
            "minItems": 1, "maxItems": 1,
            "items": {
              "properties": {
                "run_id": {"const": "pilot-calibration"},
                "episode_id": {"const": "calibration"}
              }
            }
          },
          "limits": {
            "properties": {
              "per_call": {
                "properties": {
                  "max_total_tokens": {"const": 10000},
                  "max_wall_seconds": {"const": 300}
                }
              },
              "total": {
                "properties": {
                  "max_calls": {"const": 1},
                  "max_total_tokens": {"const": 10000},
                  "max_wall_seconds": {"const": 300}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileBindingWithId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "episode_id"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "episode_id": {"$ref": "#/$defs/id"}
      }
    },
    "perCallBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_tokens", "max_wall_seconds"],
      "properties": {
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "totalBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_calls", "max_total_tokens", "max_wall_seconds"],
      "properties": {
        "max_calls": {"type": "integer", "minimum": 1},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_call", "total"],
      "properties": {
        "per_call": {"$ref": "#/$defs/perCallBudget"},
        "total": {"$ref": "#/$defs/totalBudget"}
      }
    }
  }
}
