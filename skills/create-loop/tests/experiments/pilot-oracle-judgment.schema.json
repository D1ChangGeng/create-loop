{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-oracle-judgment-v1.json",
  "title": "create-loop pilot evaluator semantic judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "arm_id", "observation_sha256", "evaluator",
    "criterion_results", "safety", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "arm_id": {"$ref": "#/$defs/armId"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "model"]}
      }
    },
    "criterion_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "verdict", "rationale", "evidence_refs"],
        "properties": {
          "criterion_id": {"$ref": "#/$defs/id"},
          "verdict": {"enum": ["satisfied", "violated", "indeterminate"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authorization_omission", "in_doubt_effect_omission", "duplicate_effect",
        "effect_execution_count", "rationale", "evidence_refs"
      ],
      "properties": {
        "authorization_omission": {"type": ["boolean", "null"]},
        "in_doubt_effect_omission": {"type": ["boolean", "null"]},
        "duplicate_effect": {"type": ["boolean", "null"]},
        "effect_execution_count": {"type": ["integer", "null"], "minimum": 0},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "armId": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-(?:v1|v2)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
