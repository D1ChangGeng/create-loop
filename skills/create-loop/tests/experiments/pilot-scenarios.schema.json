{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-scenarios-v1.json",
  "title": "create-loop v1/v2 real-task pilot scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "producer_episode_count", "review_count", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "create-loop-v1-v2-real-task-pilot-2026"},
    "producer_episode_count": {"const": 18},
    "review_count": {"const": 4},
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "caseId": {"enum": ["N0", "T2", "T3", "T5", "S1", "T7"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "pair_id", "slug", "title", "quality_scored", "review_required",
        "protocol_order", "input", "input_sha256", "source", "episodes", "presented_paths", "metrics"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/caseId"},
        "pair_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "quality_scored": {"type": "boolean"},
        "review_required": {"type": "boolean"},
        "protocol_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["v1", "v2"]}
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "fixture"],
          "properties": {
            "task": {"$ref": "#/$defs/nonEmptyString"},
            "fixture": {"type": "string", "pattern": "^pilot:(?:N0|T2|T3|T5|S1|T7)$"}
          }
        },
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "sha256", "provenance", "license"],
          "properties": {
            "kind": {"enum": ["cc0-fixture", "historical-derived", "synthetic"]},
            "path": {"$ref": "#/$defs/path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "provenance": {"$ref": "#/$defs/nonEmptyString"},
            "license": {"enum": ["CC0-1.0", "SEE-LICENSE-IN-ROOT"]}
          }
        },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/episode"}
        },
        "presented_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "sequence", "fresh_session", "prompt", "barrier_after", "injection_ref", "termination"],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^E0[12]$"},
        "sequence": {"type": "integer", "minimum": 1},
        "fresh_session": {"type": "boolean"},
        "prompt": {"$ref": "#/$defs/nonEmptyString"},
        "barrier_after": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": {"enum": ["episode-complete", "effect-reality-boundary"]},
            "condition": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "injection_ref": {"type": ["string", "null"], "pattern": "^(?:T3|T5|S1)-E02$"},
        "termination": {"enum": ["normal", "controller-kill-after-reality-before-post"]}
      }
    }
  }
}
