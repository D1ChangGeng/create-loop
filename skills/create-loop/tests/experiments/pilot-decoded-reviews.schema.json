{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-decoded-reviews-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "algorithm", "experiment_id", "review_seal",
    "reviews", "aggregate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sealed-pilot-review-decode-v1"},
    "experiment_id": {"const": "create-loop-v1-v2-real-task-pilot-2026"},
    "review_seal": {"$ref": "#/$defs/file"},
    "reviews": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/review"}
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "pairId": {"type": "string", "pattern": "^PL-(?:T2|T3|T5|T7)-P01$"},
    "armId": {"type": "string", "pattern": "^PL-(?:T2|T3|T5|T7)-P01-v[12]$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {"A": {"$ref": "#/$defs/armId"}, "B": {"$ref": "#/$defs/armId"}}
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pair_id", "labels", "preference", "preferred_arm", "preferred_protocol",
        "severe_regression_arms", "review_result_sha256"
      ],
      "properties": {
        "pair_id": {"$ref": "#/$defs/pairId"},
        "labels": {"$ref": "#/$defs/labels"},
        "preference": {"enum": ["A", "B", "tie", "both-unacceptable"]},
        "preferred_arm": {"type": ["string", "null"], "pattern": "^PL-(?:T2|T3|T5|T7)-P01-v[12]$"},
        "preferred_protocol": {"enum": ["v1", "v2", null]},
        "severe_regression_arms": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/armId"}
        },
        "review_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
