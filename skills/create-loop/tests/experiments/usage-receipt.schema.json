{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-usage-receipt-v2.json",
  "title": "create-loop provider usage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "authorization_id", "execution_id", "run_id",
    "episode_id", "attempt_id", "role", "adapter", "cli_identity", "provider_profile",
    "model", "reasoning_effort", "tool_profile", "source_class", "provider_request_ids",
    "request_sha256", "response_sha256", "usage", "started_at", "ended_at",
    "raw_evidence_sha256", "evidence_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "execution_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "episode_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "role": {"enum": ["producer", "reviewer", "calibration"]},
    "adapter": {"$ref": "#/$defs/adapter"},
    "cli_identity": {"$ref": "#/$defs/fileBindingWithId"},
    "provider_profile": {"$ref": "#/$defs/fileBindingWithId"},
    "model": {"$ref": "#/$defs/id"},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    "tool_profile": {"$ref": "#/$defs/fileBindingWithId"},
    "source_class": {"enum": ["provider-response", "adapter-attested"]},
    "provider_request_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "response_sha256": {"$ref": "#/$defs/sha256"},
    "usage": {"$ref": "#/$defs/usage"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "ended_at": {"$ref": "#/$defs/timestamp"},
    "raw_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileBindingWithId": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "input_tokens", "cached_input_tokens", "output_tokens",
        "reasoning_output_tokens", "total_tokens", "wall_seconds"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
