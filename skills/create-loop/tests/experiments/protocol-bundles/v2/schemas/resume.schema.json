{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/resume.schema.json",
  "title": "create-loop v2 generated resume projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "generated_at", "source", "projection", "recovery_refs"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "loop_id": {"type": "string", "pattern": "^L[0-9]{3}(?:\\.[0-9]{2})*$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_sha256", "plan_version", "plan_sha256", "journal_last_seq", "journal_tail_id"],
      "properties": {
        "goal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_version": {"type": "integer", "minimum": 1},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "journal_last_seq": {"type": "integer", "minimum": 1},
        "journal_tail_id": {"type": "string", "minLength": 1}
      }
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["loop_status", "node_states", "ready_nodes", "active_nodes", "waiting_nodes", "current_evidence_refs", "open_context_ids", "pending_authorization_refs", "in_doubt_effect_ids"],
      "properties": {
        "loop_status": {"enum": ["active", "waiting", "completed", "closed"]},
        "node_states": {"type": "object", "additionalProperties": {"enum": ["pending", "active", "waiting", "verifying", "done", "closed"]}},
        "ready_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "active_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "waiting_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "current_evidence_refs": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}},
        "open_context_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "pending_authorization_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "in_doubt_effect_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "recovery_refs": {
      "type": "object", "additionalProperties": false, "required": ["confirmed_evidence", "recent_records", "latest_next_action_decision"],
      "properties": {
        "confirmed_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "recent_records": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "latest_next_action_decision": {"type": ["string", "null"]}
      }
    }
  }
}
