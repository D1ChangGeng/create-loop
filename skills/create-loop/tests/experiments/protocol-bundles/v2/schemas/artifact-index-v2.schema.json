{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/artifact-index-v2.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifacts": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "logical_name", "path", "sha256", "version", "status", "supersedes_id"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "logical_name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["active", "superseded", "retired"]},
        "supersedes_id": {"type": ["string", "null"]}
      }
    }}
  }
}
