{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/goal.schema.json",
  "title": "create-loop v2 immutable goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "goal", "intent", "scope", "success_criteria", "constraints", "authorization_boundaries", "stop_conditions", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "loop_id": {"type": "string", "pattern": "^L[0-9]{3}(?:\\.[0-9]{2})*$"},
    "goal": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "out": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "success_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "statement", "expected_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
          "statement": {"type": "string", "minLength": 1},
          "expected_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "array", "items": {"$ref": "#/$defs/named_statement"}
    },
    "authorization_boundaries": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "action", "authority", "trigger"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
          "action": {"type": "string", "minLength": 1},
          "authority": {"enum": ["user", "model", "tool", "reviewer"]},
          "trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["parent_loop_id", "parent_node_id"],
      "properties": {
        "parent_loop_id": {"type": "string", "pattern": "^L[0-9]{3}(?:\\.[0-9]{2})*$"},
        "parent_node_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "named_statement": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
