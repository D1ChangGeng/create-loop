{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/plan.schema.json",
  "title": "create-loop v2 immutable plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_version", "goal_sha256", "created_at", "control", "nodes"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "plan_version": {"type": "integer", "minimum": 1},
    "goal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "control": {
      "type": "object", "additionalProperties": false, "required": ["mode", "modules", "admission_reason"],
      "properties": {
        "mode": {"enum": ["lightweight", "persistent", "governed"]},
        "modules": {"type": "array", "uniqueItems": true, "items": {"enum": ["concurrency", "effects", "children", "artifacts", "independent_review"]}},
        "admission_reason": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "objective", "depends_on", "success_criteria_refs", "outputs", "checks", "authorization_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
          "objective": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "success_criteria_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
          "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
          "authorization_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "child_loop": {"$ref": "#/$defs/child_loop"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "control": {
            "properties": {"mode": {"const": "lightweight"}},
            "required": ["mode"]
          }
        },
        "required": ["control"]
      },
      "then": {
        "properties": {
          "control": {
            "properties": {"modules": {"const": []}},
            "required": ["modules"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "control": {
            "properties": {
              "modules": {"minItems": 1}
            },
            "required": ["modules"]
          }
        },
        "required": ["control"]
      },
      "then": {
        "properties": {
          "control": {
            "properties": {"mode": {"const": "governed"}},
            "required": ["mode"]
          }
        }
      }
    }
  ],
  "$defs": {
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path", "purpose"],
      "properties": {"path": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}}
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "method", "instruction", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "method": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "child_loop": {
      "type": "object", "additionalProperties": false, "required": ["loop_id", "return_deliverables", "return_criteria_refs"],
      "properties": {
        "loop_id": {"type": "string", "pattern": "^L[0-9]{3}(?:\\.[0-9]{2})+$"},
        "return_deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "return_criteria_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
