{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-blind-review-result-v1.json",
  "title": "create-loop pilot anonymous pairwise review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "review_id", "pair_id", "case_id",
    "blind_manifest_sha256", "reviewer", "review_response_sha256", "presented",
    "isolation_manifest_sha256", "preference", "severe_regression_labels", "rationale",
    "counterexamples", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "review_id": {"$ref": "#/$defs/id"},
    "pair_id": {"$ref": "#/$defs/reviewPairId"},
    "case_id": {"enum": ["T2", "T3", "T5", "T7"]},
    "blind_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "review_response_sha256": {"$ref": "#/$defs/sha256"},
    "isolation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "presented": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/presented"}},
    "preference": {"enum": ["A", "B", "tie", "both-unacceptable"]},
    "severe_regression_labels": {"type": "array", "uniqueItems": true, "items": {"enum": ["A", "B"]}},
    "rationale": {"type": "string", "minLength": 1},
    "counterexamples": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewPairId": {"type": "string", "pattern": "^PL-(?:T2|T3|T5|T7)-P01$"},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "model", "reasoning_effort", "context_manifest_sha256", "receipt_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "model"]},
        "model": {"$ref": "#/$defs/id"},
        "reasoning_effort": {"const": "ultra"},
        "context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "presented": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "artifact_sha256", "final_workspace_manifest_sha256", "evidence_manifest_sha256"],
      "properties": {
        "label": {"enum": ["A", "B"]},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "final_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
