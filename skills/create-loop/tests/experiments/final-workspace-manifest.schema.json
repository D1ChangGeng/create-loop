{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-final-workspace-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "initial_manifest_sha256", "root", "files", "changes", "aggregate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sha256-final-workspace-manifest-v1"},
    "initial_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "root": {"const": "."},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "changes": {
      "type": "object", "additionalProperties": false,
      "required": ["added", "modified", "deleted"],
      "properties": {
        "added": {"$ref": "#/$defs/paths"},
        "modified": {"$ref": "#/$defs/paths"},
        "deleted": {"$ref": "#/$defs/paths"}
      }
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
