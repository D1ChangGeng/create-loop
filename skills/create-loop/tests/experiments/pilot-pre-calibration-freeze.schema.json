{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-pre-calibration-freeze-v1.json",
  "title": "create-loop pilot pre-calibration authority freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "experiment_id", "phase", "algorithm",
    "created_at", "source_snapshots", "bindings", "files", "aggregate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "pilot-authority-freeze"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "phase": {"const": "pre-calibration"},
    "algorithm": {"const": "sha256-pilot-authority-freeze-v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_snapshots": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": [
        "preregistration", "run_plan", "instrument", "scenarios", "evaluator",
        "adapter", "provider", "producer_cli", "reviewer_cli", "tool_profile",
        "protocol_v1", "protocol_v2"
      ],
      "properties": {
        "preregistration": {"$ref": "#/$defs/binding"},
        "run_plan": {"$ref": "#/$defs/binding"},
        "instrument": {"$ref": "#/$defs/binding"},
        "scenarios": {"$ref": "#/$defs/binding"},
        "evaluator": {"$ref": "#/$defs/binding"},
        "adapter": {"$ref": "#/$defs/binding"},
        "provider": {"$ref": "#/$defs/binding"},
        "producer_cli": {"$ref": "#/$defs/binding"},
        "reviewer_cli": {"$ref": "#/$defs/binding"},
        "tool_profile": {"$ref": "#/$defs/binding"},
        "protocol_v1": {"$ref": "#/$defs/binding"},
        "protocol_v2": {"$ref": "#/$defs/binding"}
      }
    },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
