{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-blind-review-result-v1.json",
  "title": "create-loop pairwise blind review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "preregistration_sha256", "pair_id", "scenario_id",
    "blind_manifest_sha256", "reviewer", "presented", "preference", "severe_regression_labels", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "pair_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-4])-P0[1-3]$"},
    "scenario_id": {"type": "integer", "minimum": 1},
    "blind_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "presented": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/presented"}},
    "preference": {"enum": ["A", "B", "tie", "both-unacceptable", "indeterminate"]},
    "severe_regression_labels": {"type": "array", "uniqueItems": true, "items": {"enum": ["A", "B"]}},
    "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "model", "reasoning_effort", "context_manifest_sha256", "execution_receipt_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "model"]},
        "model": {"$ref": "#/$defs/id"},
        "reasoning_effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "presented": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "artifact_sha256", "trace_sha256"],
      "properties": {"label": {"enum": ["A", "B"]}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "trace_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
