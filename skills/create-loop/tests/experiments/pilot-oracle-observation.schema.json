{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-oracle-observation-v1.json",
  "title": "create-loop pilot deterministic oracle observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "arm_id", "pair_id", "case_id", "protocol",
    "final_episode_id", "trace_sha256", "initial_workspace_manifest_sha256",
    "final_workspace_manifest_sha256", "evidence_manifest_sha256", "evaluator_manifest_sha256",
    "criteria", "hidden_checks", "workspace_changes", "s1", "evidence_refs", "observed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "arm_id": {"$ref": "#/$defs/armId"},
    "pair_id": {"$ref": "#/$defs/pairId"},
    "case_id": {"enum": ["N0", "T2", "T3", "T5", "S1", "T7"]},
    "protocol": {"enum": ["v1", "v2"]},
    "final_episode_id": {"enum": ["E01", "E02"]},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "initial_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "final_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "kind", "statement", "measurement"],
        "properties": {
          "criterion_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["required", "forbidden"]},
          "statement": {"type": "string", "minLength": 1},
          "measurement": {"enum": ["hidden-test", "control-artifact-audit", "workspace-diff", "trace-review", "effect-reality"]}
        }
      }
    },
    "hidden_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "criterion_refs", "kind", "command", "script_sha256", "exit_code", "stdout", "stderr", "passed"],
        "properties": {
          "check_id": {"$ref": "#/$defs/id"},
          "criterion_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "kind": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "script_sha256": {"$ref": "#/$defs/sha256"},
          "exit_code": {"type": "integer"},
          "stdout": {"$ref": "#/$defs/file"},
          "stderr": {"$ref": "#/$defs/file"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "workspace_changes": {
      "type": "object", "additionalProperties": false,
      "required": ["added", "modified", "deleted"],
      "properties": {
        "added": {"$ref": "#/$defs/paths"},
        "modified": {"$ref": "#/$defs/paths"},
        "deleted": {"$ref": "#/$defs/paths"}
      }
    },
    "s1": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["interruption_manifest_sha256", "effect_execution_count", "operation_ids", "duplicate_effect"],
      "properties": {
        "interruption_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "effect_execution_count": {"type": "integer", "minimum": 0},
        "operation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "duplicate_effect": {"type": "boolean"}
      }
    },
    "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "pairId": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01$"},
    "armId": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-(?:v1|v2)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
