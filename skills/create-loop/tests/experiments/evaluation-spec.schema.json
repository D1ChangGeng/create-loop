{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-evaluation-spec-v1.json",
  "title": "create-loop deterministic evaluation specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "metrics", "cohorts", "gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}},
    "cohorts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scenarioIds"}},
    "gates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/gate"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "formula", "unit", "cohort"],
      "properties": {
        "source": {"enum": ["oracle", "blind_review", "deterministic_suite"]},
        "formula": {"$ref": "#/$defs/id"},
        "unit": {"$ref": "#/$defs/id"},
        "cohort": {"$ref": "#/$defs/id"}
      }
    },
    "scenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "comparison", "threshold"],
      "properties": {
        "metric": {"$ref": "#/$defs/id"},
        "comparison": {"enum": ["v2_max", "v2_min", "ratio_max_zero_baseline_requires_zero", "difference_min", "v2_not_above_v1"]},
        "threshold": {"type": ["number", "boolean"]}
      }
    }
  }
}
