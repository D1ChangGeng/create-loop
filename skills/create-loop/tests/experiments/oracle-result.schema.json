{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/experiment-oracle-result-v1.json",
  "title": "create-loop per-run independent oracle result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "preregistration_sha256", "run_plan_sha256",
    "run_id", "pair_id", "scenario_id", "protocol", "trace_sha256", "scenario_input_sha256",
    "oracle_definition_sha256", "workspace_manifest_sha256", "presented_artifact",
    "evaluator", "criterion_results", "measurements", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "run_plan_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-4])-P0[1-3]-(?:v1|v2)$"},
    "pair_id": {"type": "string", "pattern": "^S(?:0[1-9]|1[0-4])-P0[1-3]$"},
    "scenario_id": {"type": "integer", "minimum": 1},
    "protocol": {"enum": ["v1", "v2"]},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_input_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_definition_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "presented_artifact": {"$ref": "#/$defs/fileBinding"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "criterion_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "measurements": {"$ref": "#/$defs/measurements"},
    "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "context_manifest_sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["human", "model", "deterministic"]}, "context_manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion", "expectation", "verdict", "evidence_refs"],
      "properties": {
        "criterion": {"$ref": "#/$defs/id"},
        "expectation": {"enum": ["required", "forbidden"]},
        "verdict": {
          "description": "Whether the declared expectation was met. A forbidden condition that is absent is satisfied.",
          "enum": ["satisfied", "violated", "indeterminate"]
        },
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "measurements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "false_completion", "authorization_or_effect_omission", "deterministic_rejection_correct",
        "fact_checks_correct", "fact_checks_total", "recovery_tokens", "control_writes",
        "control_input_tokens", "total_input_tokens", "first_high_value_action_seconds",
        "productive_work_units", "total_work_units", "unnecessary_user_interruptions"
      ],
      "properties": {
        "false_completion": {"type": ["boolean", "null"]},
        "authorization_or_effect_omission": {"type": ["boolean", "null"]},
        "deterministic_rejection_correct": {"type": ["boolean", "null"]},
        "fact_checks_correct": {"type": ["integer", "null"], "minimum": 0},
        "fact_checks_total": {"type": ["integer", "null"], "minimum": 0},
        "recovery_tokens": {"type": ["integer", "null"], "minimum": 0},
        "control_writes": {"type": ["integer", "null"], "minimum": 0},
        "control_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "first_high_value_action_seconds": {"type": ["number", "null"], "minimum": 0},
        "productive_work_units": {"type": ["integer", "null"], "minimum": 0},
        "total_work_units": {"type": ["integer", "null"], "minimum": 0},
        "unnecessary_user_interruptions": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
