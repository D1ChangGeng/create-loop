{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-calibration-result-v1.json",
  "title": "create-loop pilot provider calibration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "run_id", "episode_id",
    "binding_root", "pre_calibration_freeze", "grant", "provider_request_ids",
    "provider_request_identity", "usage", "usage_receipt", "evidence_manifest",
    "raw_provider_events", "response", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "run_id": {"const": "pilot-calibration"},
    "episode_id": {"const": "calibration"},
    "binding_root": {"const": "experiment-authority-root"},
    "pre_calibration_freeze": {"$ref": "#/$defs/file"},
    "grant": {"$ref": "#/$defs/file"},
    "provider_request_ids": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provider_request_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "observations"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "observations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["event_type", "json_pointer", "field"],
            "properties": {
              "event_type": {"type": "string", "minLength": 1},
              "json_pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"},
              "field": {"enum": ["provider_request_id", "upstream_request_id"]}
            }
          }
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "observation"],
      "properties": {
        "value": {"$ref": "#/$defs/usageValue"},
        "observation": {
          "type": "object", "additionalProperties": false,
          "required": ["event_type", "json_pointer"],
          "properties": {
            "event_type": {"type": "string", "minLength": 1},
            "json_pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"}
          }
        }
      }
    },
    "usage_receipt": {"$ref": "#/$defs/file"},
    "evidence_manifest": {"$ref": "#/$defs/file"},
    "raw_provider_events": {"$ref": "#/$defs/file"},
    "response": {"$ref": "#/$defs/file"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "usageValue": {
      "type": "object", "additionalProperties": false,
      "required": [
        "input_tokens", "cached_input_tokens", "output_tokens",
        "reasoning_output_tokens", "total_tokens"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
