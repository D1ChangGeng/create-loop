{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/protocol-bundle-manifest-v1.json",
  "title": "create-loop frozen protocol bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "protocol", "source_snapshot", "entrypoint", "files", "aggregate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sha256-protocol-bundle-manifest-v1"},
    "protocol": {"enum": ["v1", "v2"]},
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "aggregate_sha256"],
      "properties": {
        "manifest_path": {"enum": ["baseline-source.json", "candidate-source.json"]},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entrypoint": {"const": "SKILL.md"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "aggregate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}, "mode": {"enum": ["0644", "0755"]}
      }
    }
  }
}
