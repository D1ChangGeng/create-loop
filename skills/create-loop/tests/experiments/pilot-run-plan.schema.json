{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/pilot-run-plan-v1.json",
  "title": "create-loop deterministic real-task pilot run plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "preregistration_sha256", "algorithm",
    "pair_count", "arm_count", "producer_episode_count", "arms", "runs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "create-loop-v1-v2-real-task-pilot-2026"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "algorithm": {"const": "fixed-pilot-order-v1"},
    "pair_count": {"const": 6},
    "arm_count": {"const": 12},
    "producer_episode_count": {"const": 18},
    "arms": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/arm"}},
    "runs": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "caseId": {"enum": ["N0", "T2", "T3", "T5", "S1", "T7"]},
    "protocol": {"enum": ["v1", "v2"]},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "idBinding": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "aggregate_sha256", "manifest"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/binding"}
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^protocol-bundles/(?:v1|v2)/bundle-manifest.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "episode_id", "sequence", "fresh_session", "prompt", "injection_ref", "termination"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-v[12]-E0[12]$"},
        "episode_id": {"enum": ["E01", "E02"]},
        "sequence": {"type": "integer", "minimum": 1},
        "fresh_session": {"const": true},
        "prompt": {"type": "string", "minLength": 1},
        "injection_ref": {"type": ["string", "null"], "pattern": "^(?:T3|T5|S1)-E02$"},
        "termination": {"enum": ["normal", "controller-kill-after-reality-before-post"]}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": [
        "arm_id", "pair_id", "case_id", "scenario_slug", "protocol", "arm_position",
        "workspace_seed", "input_sha256", "semantic_case_sha256",
        "initial_workspace_manifest_sha256", "protocol_source", "protocol_bundle",
        "tool_profile", "episodes"
      ],
      "properties": {
        "arm_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-v[12]$"},
        "pair_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01$"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "scenario_slug": {"type": "string", "minLength": 1},
        "protocol": {"$ref": "#/$defs/protocol"},
        "arm_position": {"type": "integer", "minimum": 1},
        "workspace_seed": {"type": "integer", "minimum": 0},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_case_sha256": {"$ref": "#/$defs/sha256"},
        "initial_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_source": {"$ref": "#/$defs/source"},
        "protocol_bundle": {"$ref": "#/$defs/bundle"},
        "tool_profile": {"$ref": "#/$defs/idBinding"},
        "episodes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/episode"}}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "arm_id", "pair_id", "case_id", "protocol", "episode_id", "sequence", "fresh_session", "injection_ref", "termination"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-v[12]-E0[12]$"},
        "arm_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01-v[12]$"},
        "pair_id": {"type": "string", "pattern": "^PL-(?:N0|T2|T3|T5|S1|T7)-P01$"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "protocol": {"$ref": "#/$defs/protocol"},
        "episode_id": {"enum": ["E01", "E02"]},
        "sequence": {"type": "integer", "minimum": 1},
        "fresh_session": {"const": true},
        "injection_ref": {"type": ["string", "null"], "pattern": "^(?:T3|T5|S1)-E02$"},
        "termination": {"enum": ["normal", "controller-kill-after-reality-before-post"]}
      }
    }
  }
}
