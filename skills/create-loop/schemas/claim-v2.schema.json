{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-loop.local/schemas/claim-v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "loop_id", "node_id", "token", "owner_id", "scope_paths", "plan_version", "acquired_at", "heartbeat_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "2.0"}, "loop_id": {"type": "string"}, "node_id": {"type": "string"},
    "token": {"type": "string", "minLength": 1}, "owner_id": {"type": "string", "minLength": 1},
    "scope_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "plan_version": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "format": "date-time"}, "heartbeat_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}
  }
}
